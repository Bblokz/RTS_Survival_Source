SeedOffset;\n float Hash(float P) { return frac(sin(P*127.1+SeedOffset)*43758.5453); }\n float Sample(float P)\n {\n  float Cell=floor(P), Blend=frac(P);\n  Blend=Blend*Blend*(3.0-2.0*Blend);\n  return lerp(Hash(Cell),Hash(Cell+1.0),Blend);\n }\n};\nFFakeRayNoise Field;\nField.SeedOffset=Seed*19.19;\nfloat Along=saturate(UV.x);\nfloat Across=(UV.y-0.5)*2.0;\nfloat Drift=Time*MotionSpeed;\nfloat Breakup=saturate(NoiseStrength);\n\n// Broad variation changes the silhouette without making the shafts wiggle quickly.\nfloat LongField=Field.Sample(Along*3.7-Drift*0.18+11.0);\nfloat Centre=(LongField-0.5)*0.04*Breakup;\nfloat Width=lerp(1.0,lerp(0.78,1.0,Field.Sample(Along*2.1+Drift*0.12+37.0)),Breakup);\nfloat SideWidth=lerp(1.0,lerp(0.82,1.0,Field.Sample(Along*2.5+Across*1.3+71.0)),Breakup);\nfloat OffsetAcross=(Across-Centre)/max(Width*SideWidth,0.2);\nfloat Edge=1.0-smoothstep(1.0-clamp(EdgeSoftness,0.01,1.0),1.0,abs(OffsetAcross));\nfloat CardEdge=1.0-smoothstep(0.85,1.0,abs(Across));\nfloat EndWidth=max(EndSoftness,0.01);\nfloat Ends=smoothstep(0.0,EndWidth,Along)*(1.0-smoothstep(1.0-EndWidth,1.0,Along));\n\n// Unequal ribbons break and fade independently along the beam.\nfloat Density=max(StreakDensity,1.0);\nfloat RibbonWarp=(Field.Sample(Along*2.0-Drift*0.2+23.0)-0.5)*0.055*Breakup;\nfloat Coarse=Field.Sample(OffsetAcross*Density+RibbonWarp+Drift+Seed);\nfloat Fine=Field.Sample(OffsetAcross*Density*2.13+Along*0.09+Drift*0.4+59.0);\nfloat Ribbons=lerp(0.03,1.15,smoothstep(0.18,0.85,Coarse))*lerp(0.4,1.0,Fine);\nfloat Streaks=lerp(1.0,Ribbons,saturate(StreakStrength));\nfloat Cloudlets=Field.Sample(Along*4.0+Across*1.6-Drift*0.3+83.0);\nfloat Detail=Field.Sample(Along*9.0-Across*2.1+Drift*0.17+107.0);\nfloat Patches=smoothstep(0.18,0.82,Cloudlets*0.68+Detail*0.32);\nfloat Wisps=pow(max(lerp(1.0,lerp(0.025,1.1,Patches),Breakup),0.001),1.7);\nfloat CoreOffset=OffsetAcross-(Field.Sample(Along*2.5+127.0)-0.5)*0.04*Breakup;\nfloat Core=exp(-pow(CoreOffset/max(CoreWidth,0